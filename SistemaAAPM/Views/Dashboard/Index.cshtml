@model SistemaAAPM.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "../Shared/_LayoutADM.cshtml";
}

<div class="container mt-4" style="margin-left: 320px">
    <h2 style="color: #0b0b0b; font-weight: bold; margin-bottom: 24px;">Visão Geral do Sistema</h2>

    <div class="dashboard-grid">
        <div class="dash-card">
            <div class="dash-icon" style="background-color: rgba(46,7,235,0.1); color: #2e07eb;">
                <i class="fas fa-users"></i>
            </div>
            <div class="dash-info">
                <h3>Associados</h3>
                <p class="dash-number">@Model.TotalAssociados</p>
            </div>
        </div>

        <div class="dash-card">
            <div class="dash-icon" style="background-color: rgba(16,185,129,0.1); color: #10b981;">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <div class="dash-info">
                <h3>Cursos</h3>
                <p class="dash-number">@Model.TotalCursos</p>
            </div>
        </div>

        <div class="dash-card">
            <div class="dash-icon" style="background-color: rgba(245,158,11,0.1); color: #f59e0b;">
                <i class="fas fa-door-open"></i>
            </div>
            <div class="dash-info">
                <h3>Salas</h3>
                <p class="dash-number">@Model.TotalSalas</p>
            </div>
        </div>

        <div class="dash-card">
            <div class="dash-icon" style="background-color: rgba(239,68,68,0.1); color: #ef4444;">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="dash-info">
                <h3>Eventos</h3>
                <p class="dash-number">@Model.TotalEventos</p>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS exclusivo para o Dashboard (pode colar no seu arquivo CSS principal depois) */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .dash-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 6px 18px rgba(16,24,40,0.06);
        display: flex;
        align-items: center;
        gap: 20px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e6e9ee;
    }

        .dash-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(46,7,235,0.12);
        }

    .dash-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .dash-info h3 {
        margin: 0;
        font-size: 1rem;
        color: #6b7280;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .dash-number {
        margin: 5px 0 0 0;
        font-size: 2.5rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
    }
</style>