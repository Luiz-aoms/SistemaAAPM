@model DataTable
@using System.Data

@{
    ViewData["Title"] = "Associados";
    Layout = "../Shared/_LayoutADM.cshtml";
}




<div class="container-fluid">

    <br />
    <br />
    <br />
    <br />

    <h2 style="margin-left: 240px" class="title text-center">CONTROLE DE ASSOCIADOS</h2>


    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success" style="margin-left: 320px" role="alert">
            @TempData["MsgSucesso"] &emsp;

            <button type="button"
                    class="fechar-alert btn btn-success btn-sm"
                    arial-label="Close"> X
            </button>
        </div>
    }


    @if (TempData["MsgErro"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["MsgErro"] &emsp;

            <button type="button"
                    class="fechar-alert btn btn-danger btn-sm"
                    arial-label="Close"> X
            </button>
        </div>
    }

    <br />



</div>

<br />
<br />
<br />








<div class="ins-btn">
    <div class="row">
        <div class="col-md-12">

            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <a class="btn btn-primary" role="button" asp-controller="Associado"
                   asp-action="InserirExibir"><i class="bi bi-plus"></i> Adicionar</a>
            </div>

        </div>
    </div>
</div>


<br />
<br />
<br />



<div class="fade-in" id="meuElemento">

    <div class="row">
        <div class="col-md-12 d-flex flex-column">

            <table id="table" class="table table-striped teble-houver table-bordered ">
                <thead class="border-3 border-dark rounded-top table-dark">
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Cpf</th>
                        <th scope="col">Curso</th>
                        <th scope="col">Senha Armário</th>
                        <th scope="col">Telefone</th>
                        <th scope="col">Sala</th>
                        <th scope="col">Editar  &emsp; - &emsp;  Excluir</th>
                    </tr>
                </thead>
                <tbody class="border-3 border-dark rounded-bottom">
                    @if (Model != null)
                    {
                        @foreach (DataRow row in Model.Rows)
                        {
                            <tr>
                                <td>@row["Nome"]</td>
                                <td>@row["Cpf"]</td>
                                <td>@row["curso"]</td>
                                <td>@row["Senha_Armario"]</td>
                                <td>@row["Fone"]</td>
                                <td>@row["salas"]</td>
                                <td>
                                    <div class="btn-group" role="group" aria-label="Basic example">
                                        <a role="button " class="btn btn-primary"
                                           asp-controller="Associado"
                                           asp-action="AlterarExibir"
                                           asp-route-idAssociado="@row["Id_Associado"]"><i class="bi bi-pencil"></i></a>

                                        &emsp;
                                        &emsp;
                                        &emsp;

                                        <a role="button " class="btn btn-danger"
                                           asp-controller="Associado"
                                           asp-action="ExcluirExibir"
                                           asp-route-idAssociado="@row["Id_Associado"]"><i class="bi bi-trash-fill"></i></a>
                                    </div>
                                </td> 
                            </tr>
                        }
                    }

                </tbody>
            </table>

        </div>
    </div>
</div>
<div />
