@using Microsoft.AspNetCore.Identity;
@inject SignInManager<IdentityUser> SignInManager;

@if(SignInManager.IsSignedIn(User))
{
    <form asp-area="" asp-controller="Account" asp-action="Logout" id="logoutForm"
       method="post" class="bavbar-left">
        <div class="user-widget" role="region" aria-label="Usuário conectado">
            <div class="user-info">
                <div class="avatar" aria-hidden="true">
                    <!-- ícone SVG simbólico de usuário -->
                    <svg viewBox="0 0 24 24" width="36" height="36" focusable="false" aria-hidden="true">
                        <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-4.418 0-8 2.239-8 5v1h16v-1c0-2.761-3.582-5-8-5z" fill="currentColor" />
                    </svg>
                    <span class="status-dot" title="Online" aria-hidden="true"></span>
                </div>

                <div class="user-text">
                    <div class="user-name" id="user-name">@User.Identity.Name</div>
                    <div class="user-sub" id="user-sub"><a asp-controller="Curso" asp-action="Selecionar">Area de administração</a></div>
                </div>
            </div>

            <button class="logout-btn" id="logout-btn" aria-label="Sair">
                <i class="bi bi-box-arrow-left"></i>
            </button>
        </div>
    </form>
}
else
{


    <button class="login-btn" id="login-btn">
        <svg class="login-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="18" height="18">
            <path d="M10 17l5-5-5-5M15 12H3m6 8h10a2 2 0 002-2V6a2 2 0 00-2-2H9"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <a class="nav-link" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@string.Format("{0}{1}", Context.Request.Path, Context.Request.QueryString)" style="color:white">&nbsp; Entrar &nbsp;</a>
    </button>
}
