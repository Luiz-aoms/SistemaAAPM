@model EventosViewModel
@{
    ViewData["Title"] = "Inserir Evento";
    Layout = "../Shared/_LayoutADM.cshtml";
}

<div id="meuElemento" class="d-flex">
    <h2 class="text-center" style="margin-top: 100px; margin-bottom: 100px; color:black">
        <a class="btn" style="margin-right:270px; color:black" role="button"
           asp-controller="Eventos"
           asp-action="Selecionar"><i class="bi bi-arrow-left"></i> Voltar</a>

        INSERIR EVENTO
    </h2>
</div>

<form asp-controller="Eventos" asp-action="InserirProcessar" asp-route-idEvento="@Model.IdEvento" method="post">

    <div class="row gx-5" id="meuElemento">
        <div class="col-md-5">

            <label for="nome" class="form-label">Nome Evento</label>
            <input type="text" class="form-control" id="nome"
                   placeholder="Digite o Nome do Evento." asp-for="NomeEvento">
            <span asp-validation-for="NomeEvento" class="text-danger"></span>
        </div>

        <div class="col-md-5" style="margin-left:100px">

            <label for="desEvento" class="form-label">Descrição Evento</label>
            <input type="text" class="form-control" id="desEvento"
                   placeholder="Digite a Descrição do Evento." asp-for="DescricaoEvento">

        </div>
    </div>
    <br />

    <div class="row gx-5" id="meuElemento">
        <div class="col-md-5">
            <label for="DataEvento" class="form-label">Data do Evento</label>
            <input type="date" class="form-control" id="DataEvento"
                   placeholder="Data do Evento" asp-for="DataEvento">

        </div>

        <div class="col-md-5" style="margin-left:100px">

            <label for="HrEvento" class="form-label">Horário Evento</label>
            <input type="text" class="form-control" id="HrEvento" maxlength="5"
                   placeholder="Digite o Horário do Evento.(Ex:18:30)" asp-for="HorarioEvento">

        </div>
    </div>

    <br />


    <br />

    <<div class="d-grid gap-6" id="meuElemento">
        <button style="margin-left:230px; width:500px" type="submit" class="btn btn-primary">Inserir</button>
        &emsp;
    </div>
</form>