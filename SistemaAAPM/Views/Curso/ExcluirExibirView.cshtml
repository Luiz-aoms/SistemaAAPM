@model CursoVM

@{
    ViewData["Title"] = "Excluir Curso";
    Layout = "../Shared/_LayoutADM.cshtml";
}

<div id="meuElemento" class="d-flex">
    <h2 class="text-center" style="margin-top: 100px; margin-bottom: 100px; color:black">
        <a class="btn" style="margin-right:270px; color:black" role="button"
           asp-controller="Curso"
           asp-action="Selecionar"><i class="bi bi-arrow-left"></i> Voltar</a> 
           
          EXCLUIR CURSO
    </h2>
</div>

@if (TempData["MsgErro"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["MsgErro"] &emsp;

        <button type="button"
                class="fechar-alert btn btn-danger btn-sm"
                arial-label="Close">
            X
        </button>
    </div>
}

<div class="text-center">
    <h3 class="text-danger fw-bolder" style="margin-left:200px; margin-bottom:70px"> Realmente deseja excluir o Curso atual?</h3>
</div>


<form asp-controller="Curso" asp-action="ExcluirProcessar" method="post">

    <div>
        <input type="hidden" asp-for="IdCursos" />
    </div>

    <div class="row gx-5" id="meuElemento">
        <div class="col-md-5">

            <label for="Nome" class="form-label">Nome Curso</label>
            <input type="text" class="form-control" id="nome"
                   placeholder="Digite o nome." asp-for="NomeCursos" readonly>
            <span asp-validation-for="NomeCursos" class="text-danger"></span>
        </div>

        <div class="col-md-5" style="margin-left:100px">

            <label for="Cpf" class="form-label">Sigla Curso</label>
            <input type="text" class="form-control" id="Cpf"
                   placeholder="Digite o CPF." asp-for="SiglaCurso" readonly>

        </div>
    </div>
    <br />

    <div class="row gx-5" id="meuElemento">
        <div class="col-md-5">
            <label for="DtInicio" class="form-label">Data de Início</label>
            <input type="date" class="form-control" id="DtInicio"
                   placeholder="Informe a Data de Início." asp-for="DataInicio" readonly>

        </div>

        <div class="col-md-5" style="margin-left:100px">
            <label for="DtTermino" class="form-label">Data de Termino</label>
            <input type="date" class="form-control" id="DtTermino"
                   placeholder="Informe a Data de Termino." asp-for="DataTermino" readonly>

        </div>

    </div>

    <br />

    <br />

    <div class="d-grid gap-6" id="meuElemento">
        <button style="margin-left:230px; width:500px" type="submit" class="btn btn-danger">Excluir</button>
        &emsp;
    </div>
</form>
