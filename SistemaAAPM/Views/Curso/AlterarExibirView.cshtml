@model CursoVM
@{
    ViewData["Title"] = "Alterar Curso";
    Layout = "../Shared/_LayoutADM.cshtml";
}


<div id="meuElemento" class="d-flex">
    <h2 class="text-center" style="margin-top: 100px; margin-bottom: 100px; color:black">
        <a class="btn" style="margin-right:270px; color:black" role="button"
           asp-controller="Curso"
           asp-action="Selecionar"><i class="bi bi-arrow-left"></i> Voltar</a>

        ALTERAR CURSO
    </h2>
</div>

@if (TempData["MsgErro"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["MsgErro"] &emsp;

        <button type="button"
                class="fechar-alert btn btn-danger btn-sm"
                arial-label="Close">
            X
        </button>
    </div>
}

<form asp-controller="Curso" asp-action="AlterarProcessar" method="post">

    <div>
        <input type="hidden" asp-for="IdCursos" />
    </div>


    <div class="row gx-5" id="meuElemento">
        <div class="col-md-5">

            <label for="Nome" class="form-label">Nome Curso</label>
            <input type="text" class="form-control" id="Nome"
                   placeholder="Digite o nome." asp-for="NomeCursos">
            <span asp-validation-for="NomeCursos" class"text-danger"></span>
        </div>

        <div class="col-md-5" style="margin-left:100px">

            <label for="cpf" class="form-label">Sigla Curso</label>
            <input type="text" class="form-control" id="cpf"
                   placeholder="Digite o CPF." asp-for="SiglaCurso">

        </div>
    </div>
    <br />

    <div class="row gx-5" id="meuElemento">
        <div class="col-md-5">
            <label for="Telefone" class="form-label">Data de Início</label>
            <input type="date" class="form-control" id="Validade"
                   placeholder="Informe a Data de Início." asp-for="DataInicio">

        </div>

        <div class="col-md-5" style="margin-left:100px">
            <label for="DtTermino" class="form-label">Data de Término</label>
            <input type="date" class="form-control" id="DtTermino"
                   placeholder="Informe a Data de Término." asp-for="DataTermino">

        </div>

    </div>

    <br />
    <br />

    <div class="d-grid gap-6" id="meuElemento">
        <button style="margin-left:230px; width:500px" type="submit" class="btn btn-primary">Alterar</button>
        &emsp;
    </div>
</form>




